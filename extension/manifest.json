{
  "manifest_version": 3,
  "name": "Smash the Peak Recorder",
  "version": "0.1.0",
  "description": "Starts/stops OBS recording automatically when you play a match on smashthepeak.eu (requires the PeakRecorder companion app).",
  "permissions": ["storage", "alarms", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8123/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.smashthepeak.eu/*", "https://smashthepeak.eu/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png"
    },
    "default_title": "Smash the Peak Recorder"
  }
}
